singularity {
    enabled = true
    autoMounts = true               //if false, workdir not found
    runOptions = [
        "--bind /srv/scratch/iai",
        "--bind /srv/net/cluqumngs",
        "--bind /srv/scratch/SLURM"
    ].join(' ')
    envWhitelist = "http_proxy,https_proxy,HTTP_PROXY,HTTPS_PROXY"
}


profiles {
    local {
        process.executor = 'local'
        process.cpus = 16
        process.memory = '600 GB'
        process.maxForks = 4
    }

    slurm {
        process.executor = 'slurm'

        process.queue   = 'diag_iai'
        process.cpus    = 1
        process.memory  = '200 GB'
        process.time    = '24h'
        process.maxForks = 1

        process.clusterOptions = "--account=iai --partition=diag_iai"
    }
}


process {
    withLabel: "fastqc" {
        container = "/srv/scratch/iai/bachcl/singularity/fastqc_v0.12.1.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "multiqc" {
        container = "/srv/scratch/iai/bachcl/singularity/multiqc_v1.33.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "fastp" {
        container = "/srv/scratch/iai/bachcl/singularity/fastp_v1.3.2.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "bbtools" {
        container = "/srv/scratch/iai/bachcl/singularity/bbtools_v39.81.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }
        
        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }
    
    withLabel: "seqkit" {
        container = "/srv/scratch/iai/bachcl/singularity/seqkit_v2.13.0.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }
    
    withLabel: "kraken2" {
        container = "/srv/scratch/iai/bachcl/singularity/kraken2_v2.17.1.sif"
        maxForks = 1
        cpus = 1
        memory = { 90.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    
    withLabel: "python" {
        container = "/srv/scratch/iai/bachcl/singularity/python_plot_3.11.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }
    
    withLabel: "krona" {
        container = "/srv/scratch/iai/bachcl/singularity/kronatools_2.8.1.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }
    
    withLabel: "elgato" {
        container = "/srv/scratch/iai/bachcl/singularity/elgato_1.22.0.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }
    

    // multiple publishDir but same process 
    withName: 'MPA_FAMILY_BARPLOT' {
        publishDir = [
            [
                path: { "${params.result}/dev/1_Kraken2" },
                pattern: "*_familyBarplot.tsv",
                mode: 'copy'
            ],
            [
                path: { "${params.result}/1_Kraken2" },
                pattern: "*_familyBarplot.png",
                mode: 'copy'
            ]
        ]
    }

    withName: 'MLST_ELGATO' {
        publishDir = [
            [
                path: { "${params.result}/dev/2_ElGato" },
                pattern: "*_reads",
                mode: 'copy'
            ],
            [
                path: { "${params.result}/2_ElGato" },
                pattern: "*_MLST.tsv",
                mode: 'copy'
            ]
        ]
    }
}


// Can change anything except the params name
params {
    // TODO : adapt to SLURM folders hierarchy
    input_dir_prefix  = "/srv/net/cluqumngs/BDD_COMMUN/Illumina/FASTQ"
    output_dir_prefix = "/srv/autofs/nfs4/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_results/Nested_SBT/Illumina"
    save_dir_prefix   = "/srv/autofs/nfs4/cluqumngs/TMP_IAI/04_CNR_Legionella/Raw_fastq/Nested_SBT_NGS"
    tmp_dir_prefix    = "/srv/scratch/iai/bachcl/Raw_fastq/Legionella/Nested_SBT"
    work_dir_prefix   = "/srv/scratch/iai/bachcl/result/Legionella/Nested_SBT"

    analyse_id = new Date().format('yyyyMMdd')
    
    // User params
    suffix = ""

    // Derivated path
    input_dir  = "${params.input_dir_prefix}/Legionella-Nested-SBT-${params.suffix}"
    output_dir = "${params.output_dir_prefix}/${params.suffix}/${params.analyse_id}_ElGato-NestedSbt"
    save_dir   = "${params.save_dir_prefix}/${params.suffix}"
    tmp_dir    = "${params.tmp_dir_prefix}/${params.suffix}"
    result     = "${params.work_dir_prefix}/${params.suffix}/${params.analyse_id}_ElGato-NestedSbt"

    // Analysis paths choice
    paired_end      = true
    adapters        = true
    decontamination = false
    downsampling    = false
    kraken2_assign  = true


    // REFORMAT BBWRAP
    bbtools_downsampled = 1                     //percent of reads kept

    // TRIMMING FASTP
    min_quality = 30
    min_length  = 100

    // DECONTAMINATION BBWRAP
    bbwrap_ref       = ""                             //if empty, bbwrap_path used
    bbwrap_path      = "/srv/scratch/iai/seqmet/db/bbmap/hg38/"
    bbwrap_min_id    = 0.95
    bbwrap_max_indel = 3
    bbwrap_bwr       = 0.16
    bbwrap_bw        = 12
    bbwrap_min_hits  = 2
    bbwrap_qtrim     = "rl"
    bbwrap_trimq     = 10
    bbwrap_qin       = 33

    // ASSIGN TAXO KRAKEN2
    kraken2_db = "/srv/scratch/iai/bachcl/db/kraken2/pluspf"
    format_mpa = true                           //if false, remove MPA_* processes

    // EL GATO SBT
    elgato_depth = 1
}

// Derivated path for Work_dir
workDir = "${params.work_dir_prefix}/${params.suffix}/${params.analyse_id}_ElGato-NestedSbt/work"
