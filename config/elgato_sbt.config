def user = System.getenv('USER') ?: 'elgato-user'
def baseScratch = "/srv/scratch/iai/bachcl/tmp/${user}"

singularity {
    enabled = true
    autoMounts = true               //if false, workdir not found
    runOptions = [
        "--bind /srv/scratch/iai",
        "--bind /srv/net/cluqumngs",
        "--env TMPDIR=${baseScratch}",
        "--env HOME=${baseScratch}"
    ].join(' ')
}


profiles {
    local {
        process.executor = 'local'
        process.cpus = 16
        process.memory = '600 GB'
        process.maxForks = 4
    }
}


process {
    // Ensure that TMPDIR exists, is writable
    beforeScript = """
    mkdir -p ${baseScratch}
    export TMPDIR=${baseScratch}
    """

withLabel: "fastqc" {
        container = "/srv/scratch/iai/bachcl/singularity/fastqc_v0.12.1.sif"
        maxForks = 10
        cpus = 1
        memory = 10.GB

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "multiqc" {
        container = "/srv/scratch/iai/bachcl/singularity/multiqc_v1.33.sif"
        maxForks = 1
        cpus = 1
        memory = 50.GB

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "fastp" {
        container = "/srv/scratch/iai/bachcl/singularity/fastp_v1.3.2.sif"
        maxForks = 4
        cpus = 2
        memory = 80.GB

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "bbtools" {
        container = "/srv/scratch/iai/bachcl/singularity/bbtools_v39.81.sif"
        maxForks = 2
        cpus = 8
        memory = { 90.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    
    withLabel: "seqkit" {
        container = "/srv/scratch/iai/bachcl/singularity/seqkit_v2.13.0.sif"
        maxForks = 2
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }
    
    withLabel: "kraken2" {
        container = "/srv/scratch/iai/bachcl/singularity/kraken2_v2.17.1.sif"
        maxForks = 2
        cpus = 8
        memory = { 90.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    
    withLabel: "python" {
        container = "/srv/scratch/iai/bachcl/singularity/python_plot_3.11.sif"
        maxForks = 4
        cpus = 4
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }
    
    withLabel: "krona" {
        container = "/srv/scratch/iai/bachcl/singularity/kronatools_2.8.1.sif"
        maxForks = 4
        cpus = 4
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }
    
    withLabel: "elgato" {
        container = "/srv/scratch/iai/bachcl/singularity/elgato_1.22.0.sif"
        maxForks = 4
        cpus = 4
        memory = { 90.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    

    // multiple publishDir but same process 
    withName: 'MPA_FAMILY_BARPLOT' {
        publishDir = [
            [
                path: { "${params.result}/dev/1_Kraken2" },
                pattern: "*_familyBarplot.tsv",
                mode: 'copy'
            ],
            [
                path: { "${params.result}/1_Kraken2" },
                pattern: "*_familyBarplot.png",
                mode: 'copy'
            ]
        ]
    }

    withName: 'MLST_ELGATO' {
        publishDir = [
            [
                path: { "${params.result}/dev/2_ElGato" },
                pattern: "*_reads",
                mode: 'copy'
            ],
            [
                path: { "${params.result}/2_ElGato" },
                pattern: "*_MLST.tsv",
                mode: 'copy'
            ]
        ]
    }
}


params {
    // Notes : Settings below are set by the `start_elgato_sbt.sh` script; 
    //         values shown are indicative only and apply if the script is run directly. 
    
    def sequencing_id = "YYYYMMDD"              //locally a date
    def analyse_id = new Date().format('yyyyMMdd')
    
    suffix = "${sequencing_id}"                 //suffix for output files

    input_dir = "/srv/net/cluqumngs/BDD_COMMUN/Illumina/FASTQ/Legionella-Amplicons-${sequencing_id}"                        //input folder
    workDir = "/srv/scratch/iai/bachcl/result/Legionella/23S-5S/${sequencing_id}/${analyse_id}_ElGato-NestedSbt/work"        //working directory
    result = "/srv/scratch/iai/bachcl/result/Legionella/23S-5S/${sequencing_id}/${analyse_id}_ElGato-NestedSbt"              //output folder

    paired_end = true                           //analysis paths choice
    adapters = true
    decontamination = false
    downsampling = false
    kraken2_assign = true

    // REFORMAT
    bbtools_downsampled = 0.5                   //percent of reads kept


    // -------------------------------------------------------------------------
    // Notes : Settings below are set by the `elgato_sbt.config` file.
    // FASTP
    min_quality = 30
    min_length  = 100

    // BBWRAP
    bbwrap_ref       = ""                             //if empty, bbwrap_path used
    bbwrap_path      = "/srv/scratch/iai/seqmet/db/bbmap/hg38/"
    bbwrap_min_id    = 0.95
    bbwrap_max_indel = 3
    bbwrap_bwr       = 0.16
    bbwrap_bw        = 12
    bbwrap_min_hits  = 2
    bbwrap_qtrim     = "rl"
    bbwrap_trimq     = 10
    bbwrap_qin       = 33

    // KRAKEN2
    kraken2_db = "/srv/scratch/iai/bachcl/db/kraken2/pluspf"
    format_mpa = true                           //if false, remove MPA_* processes

    // EL GATO
    elgato_depth = 1
}
