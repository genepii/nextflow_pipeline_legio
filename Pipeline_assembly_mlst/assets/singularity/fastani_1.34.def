Bootstrap: docker
From: quay.io/biocontainers/fastani:1.34--hb66fcc3_7

%labels
    Author nextflow_pipeline_legio
    Tool FastANI
    Version 1.34
    Build hb66fcc3_7 (biocontainers)
    Reproducible true

%environment
    export LC_ALL=C
    export LANG=C

%post
    # Minimal HPC runtime utilities
    apt-get update && apt-get install -y --no-install-recommends \
        procps \
        && rm -rf /var/lib/apt/lists/*

    fastANI --version > /fastani.version.txt

%runscript
    exec "$@"

%test
    fastANI --version