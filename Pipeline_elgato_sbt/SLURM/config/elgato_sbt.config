singularity {
    enabled = true
    autoMounts = true               //if false, workdir not found

    runOptions = [
        "--bind /srv/scratch/iai",
        "--bind /srv/net/cluqumngs",
        "--bind /srv/scratch/SLURM",
        "--bind /srv/scratch/DEPOT"
    ].join(' ')
    envWhitelist = "http_proxy,https_proxy,HTTP_PROXY,HTTPS_PROXY"
}


profiles {
    local {
        process.executor = 'local'
        process.cpus = 2
        process.memory = '200 GB'
        process.maxForks = 1
    }

    slurm {
        process.executor = 'slurm'

        process.queue   = 'diag_iai'
        process.cpus    = 10
        process.memory  = '300 GB'
        process.time    = '24h'
        process.maxForks = 1

        process.clusterOptions = '--account=iai --partition=diag_iai'
    }
}


process {
    // Default process settings
    cpus = 1
    maxForks = 1
    memory = 2.GB
    scratch = true

    // maxForks labels
    withLabel: maxforks_low { maxForks = 2 }
    withLabel: maxforks_mid { maxForks = 4 }
    withLabel: maxforks_high { maxForks = 6 }

    // Memory labels
    withLabel: mem_low { memory = 4.GB }
    withLabel: mem_mid { memory = 50.GB }
    withLabel: mem_high { memory = 100.GB }

    // CPUs labels
    withLabel: cpus_low { cpus = 2 }
    withLabel: cpus_mid { cpus = 4 }
    withLabel: cpus_high { cpus = 6 }

    // Softwares labels
    withLabel: "fastqc" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/fastqc_v0.12.1.sif"
    }

    withLabel: "multiqc" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/multiqc_v1.33.sif"
    }

    withLabel: "fastp" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/fastp_v1.3.2.sif"
    }

    withLabel: "bbtools" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/bbtools_v39.81.sif"
    }
    
    withLabel: "seqkit" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/seqkit_v2.13.0.sif"
    }
    
    withLabel: "kraken2" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/kraken2_v2.17.1.sif"
    }
    
    withLabel: "python" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/python_plot_3.11.sif"
    }
    
    withLabel: "krona" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/kronatools_2.8.1.sif"
    }
    
    withLabel: "elgato" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/elgato_1.23.0.sif"
    }
}


// Can change anything except the params name
params {
    // TODO : adapt to SLURM folders hierarchy
    input_dir_prefix  = "/srv/net/cluqumngs/BDD_COMMUN/Illumina/FASTQ"
    output_dir_prefix = "/srv/autofs/nfs4/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_results/Nested_SBT/Illumina"
    save_dir_prefix   = "/srv/autofs/nfs4/cluqumngs/TMP_IAI/04_CNR_Legionella/Raw_fastq/Nested_SBT_NGS"
    tmp_dir_prefix    = "/srv/scratch/iai/bachcl/Raw_fastq/Legionella/Nested_SBT"
    work_dir_prefix   = "/srv/scratch/iai/bachcl/result/Legionella/Nested_SBT"

    analyse_id = new Date().format('yyyyMMdd')
    
    // User params
    suffix = ""

    // Derivated path
    input_dir  = "${params.input_dir_prefix}/Legionella-Nested-SBT-${params.suffix}"
    output_dir = "${params.output_dir_prefix}/${params.suffix}/${params.analyse_id}_ElGato-NestedSbt"
    save_dir   = "${params.save_dir_prefix}/${params.suffix}"
    tmp_dir    = "${params.tmp_dir_prefix}/${params.suffix}"
    result     = "${params.work_dir_prefix}/${params.suffix}/${params.analyse_id}_ElGato-NestedSbt"

    // Analysis paths choice
    paired_end      = true
    adapters        = true
    decontamination = false
    downsampling    = false
    kraken2_assign  = true


    // REFORMAT BBWRAP
    bbtools_downsampled = 1                     //percent of reads kept

    // TRIMMING FASTP
    min_quality = 30
    min_length  = 100

    // DECONTAMINATION BBWRAP
    bbwrap_ref       = ""                             //if empty, bbwrap_path used
    bbwrap_path      = "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_Database/BBmap/GRCh38/"
    bbwrap_min_id    = 0.95
    bbwrap_max_indel = 3
    bbwrap_bwr       = 0.16
    bbwrap_bw        = 12
    bbwrap_min_hits  = 2
    bbwrap_qtrim     = "rl"
    bbwrap_trimq     = 10
    bbwrap_qin       = 33

    // ASSIGN TAXO KRAKEN2
    kraken2_db = "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_Database/Kraken2/20260820_pluspf"
    format_mpa = true                           //if false, remove MPA_* processes

    // EL GATO SBT
    elgato_depth = 1
    fastfinder_desc = "Instrument ID(s),Analysis authorized by,AssayResultTargetCode"
    fastfinder_value = "NB5523331,Nextseq_IAI,WGS_SBT"
}

// Derivated path for Work_dir
workDir = "${params.work_dir_prefix}/${params.suffix}/${params.analyse_id}_ElGato-NestedSbt/work"
