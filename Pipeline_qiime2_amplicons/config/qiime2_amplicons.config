def user = System.getenv('USER') ?: 'qiime2-user'
def baseScratch = "/srv/scratch/iai/bachcl/tmp/${user}"

singularity {
    enabled = true
    autoMounts = true

    runOptions = [
        "--bind /srv/scratch/iai",
        "--bind /srv/net/cluqumngs",
        "--env TMPDIR=${baseScratch}",
        "--env HOME=${baseScratch}"
    ].join(' ')
}


profiles {
    local {
        process.executor = 'local'
        process.cpus = 2
        process.memory = '200 GB'
        process.maxForks = 1
    }
}


process {
    scratch = true
    env.QIIME2_DISABLE_PROVENANCE = "1"

    withLabel: "fastqc" {
        container = "/srv/scratch/iai/bachcl/singularity/fastqc_v0.12.1.sif"
        maxForks = 5
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "multiqc" {
        container = "/srv/scratch/iai/bachcl/singularity/multiqc_v1.33.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "fastp" {
        container = "/srv/scratch/iai/bachcl/singularity/fastp_v1.3.2.sif"
        maxForks = 4
        cpus = 2
        memory = { 2.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 4
    }

    withLabel: "qiime" {
        container = "/srv/scratch/iai/bachcl/singularity/qiime2-amplicon_krona_2024.10.sif"
        maxForks = 4
        cpus = 4
        memory = { 20.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 4
    }
}


params {
    // Notes : Settings below are set by the `start_qiime2_amplicons.sh` script; 
    //         values shown are indicative only and apply if the script is run directly. 
    
    def sequencing_id = "YYYYMMDD"              //locally a date
    def analyse_ID = new Date().format('yyyyMMdd')
    
    suffix = "${sequencing_id}"                 //suffix for output files

    input_dir = "/srv/net/cluqumngs/BDD_COMMUN/Illumina/FASTQ/Legionella-Amplicons-${sequencing_id}"                        //input folder
    workDir = "/srv/scratch/iai/bachcl/result/Legionella/23S-5S/${sequencing_id}/${analyse_ID}_Qiime2-amplicons/work"       //working directory
    result = "/srv/scratch/iai/bachcl/result/Legionella/23S-5S/${sequencing_id}/${analyse_ID}_Qiime2-amplicons"             //output folder

    paired_end = true                           //analysis paths choice
    all_in_one = false
    adapters = false
    classifier = "sklearn"


    // -------------------------------------------------------------------------
    // Notes : Settings below are set by the `qiime2_amplicons.config` file.
    // FASTP
    min_quality = 30
    min_length = 100

    // DADA2 DENOISING
    trim_left_f = 0                             //not used
    trim_left_r = 0                             //not used
    trunc_len_f = 148                           //if SE only trunc_len_f used
    trunc_len_r = 148
    reads_learn = 500000                        //error model
    fold_parents = 2
    min_reads = (params.all_in_one as Boolean) ? 0 : 5000

    // CLASSIFIER TRAINING
    db = "23s5sdb_V2.0.0"
    reads = "/srv/scratch/iai/bachcl/nextflow_pipeline_legio/Pipeline_qiime2_amplicons/assets/Merge_23S-5S_20260312_pub.fasta"
    taxa =  "/srv/scratch/iai/bachcl/nextflow_pipeline_legio/Pipeline_qiime2_amplicons/assets/23s5sdb_V2.0.0.tax"

    // TAXONOMIC CLASSIFICATION
    sklearn_confidence = 0.99
    blast_identity = 0.95
    blast_maxaccepts = 10
    blast_query_cov = 0.9
    vsearch_identity = 0.95
    vsearch_maxaccepts = 10
    vsearch_query_cov = 0
}
