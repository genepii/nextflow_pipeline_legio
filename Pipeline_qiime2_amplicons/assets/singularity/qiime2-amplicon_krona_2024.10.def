Bootstrap: docker
From: continuumio/miniconda3:latest

%labels
    Author nextflow_pipeline_legio
    Version qiime2-2024.10-krona-hpc

%post
    set -e

    export PATH=/opt/conda/bin:$PATH

    # ----------------------------
    # Base tools
    # ----------------------------
    conda update -n base -c defaults conda -y
    conda install -y -c conda-forge mamba git

    # ----------------------------
    # Shared env location (READ ONLY at runtime)
    # ----------------------------
    mamba env create -p /opt/conda/envs/qiime2 \
        --file https://data.qiime2.org/distro/amplicon/qiime2-amplicon-2024.10-py310-linux-conda.yml

    # ----------------------------
    # Krona
    # ----------------------------
    mamba install -p /opt/conda/envs/qiime2 -c bioconda krona

    # ----------------------------
    # q2-krona (best effort)
    # ----------------------------
    mamba run -p /opt/conda/envs/qiime2 pip install --no-cache-dir \
        git+https://github.com/kaanb93/q2-krona.git || true

    mamba run -p /opt/conda/envs/qiime2 qiime dev refresh-cache || true

    # ----------------------------
    # Clean build layer only
    # ----------------------------
    conda clean -afy
    rm -rf /root/.cache

%environment
    # ----------------------------
    # Core execution PATH (NO conda activate)
    # ----------------------------
    export PATH=/opt/conda/envs/qiime2/bin:/opt/conda/bin:$PATH

    # ----------------------------
    # Shared HPC scratch base (bind from host)
    # Each user gets isolated subdir
    # ----------------------------
    export HPC_SCRATCH_BASE=/srv/scratch/iai/bachcl/tmp
    export TMPDIR=${HPC_SCRATCH_BASE}/${USER:-nouser}

    export HOME=$TMPDIR
    export XDG_CONFIG_HOME=$TMPDIR/.config
    export XDG_DATA_HOME=$TMPDIR/.local
    export XDG_CACHE_HOME=$TMPDIR/.cache

    export MPLCONFIGDIR=$TMPDIR/.matplotlib
    export NUMBA_CACHE_DIR=$TMPDIR/.numba
    export QIIME2_CACHE_DIR=$TMPDIR/qiime2

    mkdir -p $TMPDIR $XDG_CONFIG_HOME $XDG_CACHE_HOME $XDG_DATA_HOME $MPLCONFIGDIR $NUMBA_CACHE_DIR $QIIME2_CACHE_DIR 2>/dev/null || true

    # ----------------------------
    # Conda runtime metadata (no activation)
    # ----------------------------
    export CONDA_DEFAULT_ENV=qiime2
    export CONDA_PREFIX=/opt/conda/envs/qiime2

%runscript
    exec qiime "$@"