singularity {
    enabled = true
    autoMounts = true

    runOptions = [
        "--bind /srv/scratch/iai",
        "--bind /srv/net/cluqumngs",
        "--bind /srv/scratch/SLURM",
        "--bind /srv/scratch/DEPOT"
    ].join(' ')
    envWhitelist = "http_proxy,https_proxy,HTTP_PROXY,HTTPS_PROXY"
}


profiles {
    local {
        process.executor = 'local'
        process.cpus = 2
        process.memory = '200 GB'
        process.maxForks = 1
    }

    slurm {
        process.executor = 'slurm'

        process.queue   = 'diag_iai'
        process.cpus    = 4
        process.memory  = '200 GB'
        process.time    = '24h'
        process.maxForks = 1

        process.clusterOptions = params.clusterOptions ?: '--account=iai --partition=diag_iai'
    }
}


process {
    scratch = true
    env.QIIME2_DISABLE_PROVENANCE = "1"

    withLabel: "fastqc" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/fastqc_v0.12.1.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "multiqc" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/multiqc_v1.33.sif"
        maxForks = 1
        cpus = 1
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "fastp" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/fastp_v1.3.2.sif"
        maxForks = 1
        cpus = 2
        memory = { 1.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 5
    }

    withLabel: "qiime" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/qiime2-amplicon_krona_2024.10.sif"
        maxForks = 1
        cpus = 4
        memory = { 20.GB * (2 ** (task.attempt - 1)) }

        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 4
    }
}


// Can change anything except the params name
params {
    // TODO : adapt to SLURM folders hierarchy
    input_dir_prefix  = "/srv/net/cluqumngs/BDD_COMMUN/Illumina/FASTQ"
    output_dir_prefix = "/srv/autofs/nfs4/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_results/23S-5S"
    save_dir_prefix   = "/srv/autofs/nfs4/cluqumngs/TMP_IAI/04_CNR_Legionella/Raw_fastq/23S-5S"
    tmp_dir_prefix    = "/srv/scratch/iai/bachcl/Raw_fastq/Legionella/23S-5S"
    work_dir_prefix   = "/srv/scratch/iai/bachcl/result/Legionella/23S-5S"

    analyse_id = new Date().format('yyyyMMdd')
    
    // User params
    suffix = ""

    // Analysis paths choice
    paired_end = true
    all_in_one = true
    adapters = true
    classifier = "sklearn"

    // Derivated path
    input_dir  = "${params.input_dir_prefix}/Legionella-Amplicons-${params.suffix}"
    output_dir = "${params.output_dir_prefix}/${params.suffix}/${params.analyse_id}_Qiime2-amplicons-${params.classifier}"
    save_dir   = "${params.save_dir_prefix}/${params.suffix}"
    tmp_dir    = "${params.tmp_dir_prefix}/${params.suffix}"
    result     = "${params.work_dir_prefix}/${params.suffix}/${params.analyse_id}_Qiime2-amplicons-${params.classifier}"


    // FASTP
    min_quality = 30
    min_length = 100

    // DADA2 DENOISING
    trim_left_f  = 0                             //not used
    trim_left_r  = 0                             //not used
    trunc_len_f  = 148                           //if SE only trunc_len_f used
    trunc_len_r  = 148
    reads_learn  = 500000                        //error model
    fold_parents = 2
    min_reads = (params.all_in_one as Boolean) ? 0 : 5000

    // CLASSIFIER TRAINING
    db     = "23s5sdb_V2.0.0"
    reads  = "/srv/scratch/iai/bachcl/nextflow_pipeline_legio/Pipeline_qiime2_amplicons/assets/Merge_23S-5S_20260312_pub.fasta"
    taxa   =  "/srv/scratch/iai/bachcl/nextflow_pipeline_legio/Pipeline_qiime2_amplicons/assets/23s5sdb_V2.0.0.tax"

    // TAXONOMIC CLASSIFICATION
    sklearn_confidence  = 0.99
    blast_identity      = 0.95
    blast_maxaccepts    = 10
    blast_query_cov     = 0.90
    vsearch_identity    = 0.95
    vsearch_maxaccepts  = 10
    vsearch_query_cov   = 0
}

// Derivated path for Work_dir
workDir = "${params.work_dir_prefix}/${params.suffix}/${params.analyse_id}_Qiime2-amplicons-${params.classifier}/work"
