singularity {
    enabled = true
    autoMounts = true

    runOptions = [
        "--cleanenv",
        "--no-home",
        "--containall",

        "--bind /srv/scratch/iai",
        "--bind /srv/net/cluqumngs",
        "--bind /srv/scratch/SLURM",
        "--bind /srv/scratch/DEPOT"
    ].join(' ')
    envWhitelist = "http_proxy,https_proxy,HTTP_PROXY,HTTPS_PROXY"
}


profiles {
    local {
        process.executor = 'local'
        process.cpus = 2
        process.memory = '200 GB'
        process.maxForks = 1
    }

    slurm {
        process.executor = 'slurm'

        process.queue   = 'diag_iai'
        process.cpus    = 10
        process.memory  = '300 GB'
        process.time    = '24h'
        process.maxForks = 1

        process.clusterOptions = "--account=iai --partition=diag_iai"
    }
}


process {
    // Default process settings
    cpus = 1
    maxForks = 1
    memory = 2.GB
    scratch = true

    // maxForks labels
    withLabel: maxforks_low { maxForks = 2 }
    withLabel: maxforks_mid { maxForks = 4 }
    withLabel: maxforks_high { maxForks = 6 }

    // Memory labels
    withLabel: mem_low { memory = 4.GB }
    withLabel: mem_mid { memory = 50.GB }
    withLabel: mem_high { memory = 100.GB }

    // CPUs labels
    withLabel: cpus_low { cpus = 2 }
    withLabel: cpus_mid { cpus = 4 }
    withLabel: cpus_high { cpus = 6 }

    // Softwares labels
    withLabel: "fastp" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/fastp_v1.3.2.sif"
    }

    withLabel: "python" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/python_plot_tree_3.11.sif"
    }

    withLabel: "snippy" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/snippy_v4.6.0.sif"
    }

    withLabel: "iqtree" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/iqtree_v3.1.3.sif"
    }

    withLabel: "gubbins" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/gubbins_v3.4.3.sif"
    }

    withLabel: "grapetree" {
        ext.version = "2.1.0" // No opt version available
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/grapetree_2.1.sif"
    }

    withLabel: "reportree" {
        container = "/srv/scratch/DEPOT/images/nextflow_pipeline_legio/reportree_2.6.1.sif"
    }
}


// Can change anything except the params name
params {
    // TODO: adapt to SLURM folders hierarchy
    output_dir_prefix    = "/srv/autofs/nfs4/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_results/Strain_comparison"
    tmp_dir_prefix       = "/srv/scratch/iai/bachcl/Raw_fastq/Legionella/Strain_comparison"
    work_dir_prefix      = "/srv/scratch/iai/bachcl/result/Legionella/Strain_comparison"
    metadata_user_prefix = "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/Input_analysis_nextflow/Strains_"

    def analyse_id = new Date().format('yyyyMMdd')
    
    // User params
    suffix = ""
    
    // Analysis paths choice
    adapters = true
    zoom="analyse"        //"none", "analyse" or one/more sample_ID

    // Derivated path
    output_dir = "${params.output_dir_prefix}/${params.suffix}/${params.analyse_id}_Assembly-MLST"
    tmp_dir    = "${params.tmp_dir_prefix}/${params.suffix}"
    result     = "${params.work_dir_prefix}/${params.suffix}/${params.analyse_id}_Assembly-MLST"
    metadata   = "${params.metadata_user_prefix}${params.suffix}"


    // FASTA RESEARCH
    // TODO: add path "/srv/net/ngs-stockage/NGS_Bacteriologie/CNR_Legionella/Legionella/Genomes"
    path_fasta = [
        "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_results/Genomes"
    ]
    fasta_prefix = false
    fasta_suffix = false
    fasta_ext = [
        ".fa",
        ".fasta",
        ".fas",
        ".fna",
        ".fsa",
        ".fsta",
        ".contigs500b.fasta"
    ]

    // FASTQ RESEARCH
    path_fastq = [
        "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/Raw_fastq/Genomes",
        "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/Raw_fastq/Strain_comparison",
        "/srv/net/ngs-stockage/NGS_Bacteriologie/CNR_Legionella/fastq/Legionella_Genomes"
    ]
    fastq_prefix = false
    fastq_suffix = [
        "*_R{1,2}_*",
        "*_R{1,2}",
        "*_{1,2}_*",
        "*_{1,2}"
    ]
    fastq_ext = [
        ".fastq.gz",
        ".fq.gz"
    ]

    // SNIPPY
    snippy_dir="/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_Database/Snippy"
    snippy_ref = [
        [
            st: 1,
            previous: "${snippy_dir}/ST1",
            ref: "${snippy_dir}/ST1_Lp-Paris_CR628336.1.fasta"
        ],
        [
            st: 23,
            previous: "${snippy_dir}/ST23",
            ref: "${snippy_dir}/ST23_Lp_HL04433031.fasta"
        ]
    ]
    snippy_opts = "--force --quiet"

    // FASTP
    min_quality = 30
    min_length = 100

    // IQTREE
    iqtree_bootstrap = 1000
    iqtree_alrt = 1000
    iqtree_model = "GTR+G"
    iqtree_color_by = "Origin"

    // GUBBINS
    gubbins_percent = 25

    // CHEWBBACA + GRAPETREE + REPORTREE
    chewbbaca_set = [
        [
            nb: 1521,
            genes: "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_Database/chewBBACA/1521cgMLST_LIT_20260724.txt",
            previous: "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_Database/ReporTree/Lp_1521genes_MLSTchewbbaca.tsv",
            nomenclature: "none",
            grapetree: true,
            reportree: false
        ],
        [
            nb: 2009,
            genes: "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_Database/chewBBACA/2009cgMLST_LIT_20260724.txt",
            previous: "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_Database/ReporTree/Lp_4707genes_MLSTchewbbaca.tsv",
            nomenclature: "/srv/net/cluqumngs/TMP_IAI/04_CNR_Legionella/NGS_Database/ReporTree/Lp_4707genes_partitions.tsv",
            grapetree: false,
            reportree: true
        ]
    ]

    // GRAPETREE
    grape_model = "MSTreeV2"

    // REPORTREE
    rep_interest = 6                                //could be 1 value or a list of threshold or cluster name
    rep_site_inclusion = 1.0
    rep_min_allele = 6                              //int or "none" for all clusters 
    rep_max_allele = "none"                         //int or "none" for one cluster at rep_min_allele
    rep_loci_called = 0.95
    rep_col_metadata = "ST"
    rep_col_report = "ST,Year,Origin"
    rep_model = "MSTreeV2"
    rep_analysis = "grapetree"

}

// Derivated path for Work_dir
workDir = "${params.work_dir_prefix}/${params.suffix}/${params.analyse_id}_Assembly-MLST/work"
